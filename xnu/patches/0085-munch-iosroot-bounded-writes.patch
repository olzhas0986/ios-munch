+		if (!count || lba < MUNCH_ROOT_FIRST || lba - MUNCH_ROOT_FIRST >= MUNCH_ROOT_BLOCKS ||
+		    count > MUNCH_ROOT_BLOCKS - (lba - MUNCH_ROOT_FIRST) || len != count * UFS_BLOCK) { return EPERM; }
+	} else if (cdb[0] == 0x35) {
