+
+static int
+ufs_write_blocks(uint64_t lba, uint32_t count)
+{
+	if (!su.ready || !su.writable || su.first_block != MUNCH_ROOT_FIRST || su.nblocks != MUNCH_ROOT_BLOCKS ||
+	    count == 0 || count > BOUNCE_SIZE / UFS_BLOCK || lba < su.first_block ||
+	    lba - su.first_block >= su.nblocks || count > su.nblocks - (lba - su.first_block)) {
+		return EPERM;
+	}
+	uint8_t cdb[10] = { 0x2a, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0 };
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, true);
+}
+
+static int
+ufs_sync_cache(void)
+{
+	static const uint8_t cdb[10] = { 0x35 };
+	return ufs_scsi(cdb, sizeof(cdb), 0, false);
