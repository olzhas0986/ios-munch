diff --git a/iokit/Kernel/arm/SweetEntitlements.cpp b/iokit/Kernel/arm/SweetEntitlements.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetEntitlements.cpp
@@ -0,0 +1,184 @@
+/*
+ * Entitlements for the SWEET built-in AMFI interface (bsd/kern/sweet_amfi.c).
+ *
+ * Apple's AMFI keeps a CoreEntitlements context per code signature; that
+ * library is closed. Here each signature with an XML entitlements blob gets
+ * a SweetEntitlements object: the blob parsed into an OSDictionary (the
+ * representation IOKit and the kernel KPIs hand out) plus the original XML,
+ * which csops(CS_OPS_ENTITLEMENTS_BLOB) returns. The blob was already
+ * checked against the code directory by csblob_get_entitlements().
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSUnserialize.h>
+#include <kern/cs_blobs.h>
+
+class SweetEntitlements : public OSObject {
+	OSDeclareDefaultStructors(SweetEntitlements);
+
+public:
+	OSDictionary *dict;
+	CS_GenericBlob *xml;            /* the signature's blob, header included */
+	size_t xml_len;
+
+	bool init(void) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetEntitlements, OSObject);
+
+bool
+SweetEntitlements::init(void)
+{
+	return OSObject::init();
+}
+
+void
+SweetEntitlements::free(void)
+{
+	OSSafeReleaseNULL(dict);
+	if (xml) {
+		kfree_data(xml, xml_len);
+		xml = NULL;
+	}
+	OSObject::free();
+}
+
+static SweetEntitlements *
+sweet_ent(const void *obj)
+{
+	return OSDynamicCast(SweetEntitlements, (OSObject *)(uintptr_t)obj);
+}
+
+extern "C" {
+/* Parsed entitlements for one XML blob (header included), or NULL. Retained. */
+void *
+sweet_entitlements_create(const CS_GenericBlob *blob, size_t blob_len)
+{
+	if (blob == NULL || blob_len <= sizeof(CS_GenericBlob) ||
+	    ntohl(blob->magic) != CSMAGIC_EMBEDDED_ENTITLEMENTS ||
+	    ntohl(blob->length) != blob_len) {
+		return NULL;
+	}
+
+	/* OSUnserializeXML needs a terminating NUL inside the buffer. */
+	size_t text_len = blob_len - sizeof(CS_GenericBlob);
+	char *text = (char *)kalloc_data(text_len + 1, Z_WAITOK);
+	if (text == NULL) {
+		return NULL;
+	}
+	memcpy(text, blob->data, text_len);
+	text[text_len] = '\0';
+	OSObject *parsed = OSUnserializeXML(text, text_len + 1);
+	kfree_data(text, text_len + 1);
+
+	OSDictionary *dict = OSDynamicCast(OSDictionary, parsed);
+	if (dict == NULL) {
+		OSSafeReleaseNULL(parsed);
+		return NULL;
+	}
+
+	SweetEntitlements *ent = OSTypeAlloc(SweetEntitlements);
+	CS_GenericBlob *xml = (CS_GenericBlob *)kalloc_data(blob_len, Z_WAITOK);
+	if (ent == NULL || !ent->init() || xml == NULL) {
+		OSSafeReleaseNULL(ent);
+		if (xml) {
+			kfree_data(xml, blob_len);
+		}
+		dict->release();
+		return NULL;
+	}
+	memcpy(xml, blob, blob_len);
+	ent->dict = dict;
+	ent->xml = xml;
+	ent->xml_len = blob_len;
+	return ent;
+}
+
+/* The entitlements as an OSDictionary. Retained. */
+void *
+sweet_entitlements_copy_dict(const void *obj)
+{
+	SweetEntitlements *ent = sweet_ent(obj);
+	if (ent == NULL) {
+		return NULL;
+	}
+	ent->dict->retain();
+	return ent->dict;
+}
+
+/* A kalloc_data copy of the XML blob; the caller frees it (blob length). */
+bool
+sweet_entitlements_copy_xml(const void *obj, CS_GenericBlob **out)
+{
+	SweetEntitlements *ent = sweet_ent(obj);
+	if (ent == NULL) {
+		return false;
+	}
+	CS_GenericBlob *copy = (CS_GenericBlob *)kalloc_data(ent->xml_len, Z_WAITOK);
+	if (copy == NULL) {
+		return false;
+	}
+	memcpy(copy, ent->xml, ent->xml_len);
+	*out = copy;
+	return true;
+}
+
+/* name is true (a boolean entitlement). */
+bool
+sweet_entitlements_bool(const void *obj, const char *name)
+{
+	SweetEntitlements *ent = sweet_ent(obj);
+	return ent != NULL && ent->dict->getObject(name) == kOSBooleanTrue;
+}
+
+/* name is the string value, or an array containing it. */
+bool
+sweet_entitlements_string(const void *obj, const char *name, const char *value)
+{
+	SweetEntitlements *ent = sweet_ent(obj);
+	if (ent == NULL || value == NULL) {
+		return false;
+	}
+	OSObject *v = ent->dict->getObject(name);
+	OSString *s = OSDynamicCast(OSString, v);
+	if (s != NULL) {
+		return s->isEqualTo(value);
+	}
+	OSArray *a = OSDynamicCast(OSArray, v);
+	for (unsigned int i = 0; a != NULL && i < a->getCount(); i++) {
+		s = OSDynamicCast(OSString, a->getObject(i));
+		if (s != NULL && s->isEqualTo(value)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Number of entitlements. */
+unsigned int
+sweet_entitlements_count(const void *obj)
+{
+	SweetEntitlements *ent = sweet_ent(obj);
+	return ent != NULL ? ent->dict->getCount() : 0;
+}
+
+/* The value of name, or NULL. Retained. */
+void *
+sweet_entitlements_copy_object(const void *obj, const char *name)
+{
+	SweetEntitlements *ent = sweet_ent(obj);
+	OSObject *v = ent != NULL ? ent->dict->getObject(name) : NULL;
+	if (v != NULL) {
+		v->retain();
+	}
+	return v;
+}
+}
+#endif /* SWEET */
diff --git a/iokit/Kernel/arm/SweetKeyStore.cpp b/iokit/Kernel/arm/SweetKeyStore.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetKeyStore.cpp
@@ -0,0 +1,227 @@
+/*
+ * Built-in AppleKeyStore for SWEET: a device without a passcode whose
+ * system keybag is always loaded and unlocked.
+ *
+ * Apple's AppleKeyStore kext (closed, SEP-backed) owns the keybags behind
+ * data protection. libaks (AppleKeyStore.framework, statically in keybagd)
+ * opens IOServiceMatching("AppleKeyStore") with type 0, calls selector 0,
+ * then one selector per aks_* function (iOS 16.7 numbering below). keybagd
+ * --init asks for the system bag (14) and only loads systembag.kb when the
+ * answer is kIOReturnNotFound; answering with a handle is the path a
+ * userspace reboot takes, so no bag file is needed.
+ *
+ * Every call is logged (selector, caller, argument shapes, result) so the
+ * next selectors the system needs show up on the console; unknown ones fail
+ * with kIOReturnUnsupported.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <libkern/c++/OSString.h>
+#include <sys/proc.h>
+
+/* libaks selectors (AppleKeyStore.framework, iOS 16.7). */
+enum {
+	kAKSOpen             = 0,
+	kAKSCreateBag        = 2,
+	kAKSSaveBag          = 3,
+	kAKSUnloadBag        = 4,
+	kAKSSetSystem        = 5,
+	kAKSLoadBag          = 6,
+	kAKSGetLockState     = 7,
+	kAKSUnlockDevice     = 9,
+	kAKSWrapKey          = 10,
+	kAKSUnwrapKey        = 11,
+	kAKSUnlockBag        = 12,
+	kAKSLockBag          = 13,
+	kAKSGetSystem        = 14,
+	kAKSGetDeviceState   = 17,
+	kAKSAssertHold       = 26,
+	kAKSAssertDrop       = 27,
+	kAKSUnloadSessionBags = 55,
+	kAKSNotifyStateSet   = 102,
+};
+
+/* The system (device) bag handle. */
+#define SWEET_AKS_SYSTEM_HANDLE 0
+
+/*
+ * aks lock state bits (aks_get_lock_state): bit 2 is "unlocked since boot"
+ * (MobileKeyBag MKBDeviceUnlockedSinceBoot); clear lock bits = unlocked.
+ */
+#define SWEET_AKS_LOCK_STATE    0x4
+
+class AppleKeyStore : public IOService {
+	OSDeclareDefaultStructors(AppleKeyStore);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleKeyStore, IOService);
+
+bool
+AppleKeyStore::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleKeyStoreUserClient");
+	registerService();
+	IOLog("MUNCH AKS: AppleKeyStore registered (no passcode, unlocked)\n");
+	return true;
+}
+
+class AppleKeyStoreUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleKeyStoreUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleKeyStoreUserClient, IOUserClient);
+
+IOReturn
+AppleKeyStoreUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+/* Copy len bytes to the caller's output structure (inband or descriptor). */
+static IOReturn
+sweet_aks_struct_out(IOExternalMethodArguments *args, const void *buf, uint32_t len)
+{
+	if (args->structureOutputDescriptor != NULL) {
+		if (len > args->structureOutputDescriptor->getLength()) {
+			return kIOReturnNoSpace;
+		}
+		args->structureOutputDescriptor->writeBytes(0, buf, len);
+		args->structureOutputDescriptorSize = len;
+		return kIOReturnSuccess;
+	}
+	if (args->structureOutput == NULL || len > args->structureOutputSize) {
+		return kIOReturnNoSpace;
+	}
+	memcpy(args->structureOutput, buf, len);
+	args->structureOutputSize = len;
+	return kIOReturnSuccess;
+}
+
+/* Append SEQUENCE { UTF8String key, INTEGER value } (short forms only). */
+static uint32_t
+sweet_aks_der_pair(uint8_t *p, const char *key, uint8_t value)
+{
+	uint32_t klen = (uint32_t)strlen(key);
+	uint32_t n = 0;
+	p[n++] = 0x30;
+	p[n++] = (uint8_t)(2 + klen + 3);
+	p[n++] = 0x0c;
+	p[n++] = (uint8_t)klen;
+	memcpy(p + n, key, klen);
+	n += klen;
+	p[n++] = 0x02;
+	p[n++] = 0x01;
+	p[n++] = value;
+	return n;
+}
+
+/*
+ * Device state (selector 17): a DER SET of key/INTEGER pairs that libaks
+ * decode_extended_state reads: ss state, sls lock state (MKBGetDeviceLockState:
+ * 0 = unlocked), sb backoff, sfa failed attempts, sgs generation, sas
+ * assertions, sgpe grace period, srcd recovery countdown.
+ */
+static IOReturn
+sweet_aks_device_state(IOExternalMethodArguments *args)
+{
+	static const struct {
+		const char *key;
+		uint8_t value;
+	} fields[] = {
+		{ "ss", SWEET_AKS_LOCK_STATE }, { "sls", 0 }, { "sb", 0 }, { "sfa", 0 },
+		{ "sgs", 0 }, { "sas", 0 }, { "sgpe", 0 }, { "srcd", 0 },
+	};
+	uint8_t buf[128];
+	uint32_t n = 2;
+	for (unsigned int i = 0; i < sizeof(fields) / sizeof(fields[0]); i++) {
+		n += sweet_aks_der_pair(buf + n, fields[i].key, fields[i].value);
+	}
+	buf[0] = 0x31;
+	buf[1] = (uint8_t)(n - 2);
+	return sweet_aks_struct_out(args, buf, n);
+}
+
+static uint32_t
+sweet_aks_struct_out_size(IOExternalMethodArguments *args)
+{
+	return args->structureOutputDescriptor != NULL ?
+	       (uint32_t)args->structureOutputDescriptor->getLength() : args->structureOutputSize;
+}
+
+IOReturn
+AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	IOReturn ret = kIOReturnSuccess;
+	uint32_t in_scalars = args->scalarInputCount;
+	uint32_t in_struct = args->structureInputDescriptor != NULL ?
+	    (uint32_t)args->structureInputDescriptor->getLength() : args->structureInputSize;
+	uint32_t out_scalars = args->scalarOutputCount;
+	uint32_t out_struct = sweet_aks_struct_out_size(args);
+	uint64_t arg0 = in_scalars > 0 ? args->scalarInput[0] : 0;
+
+	switch (selector) {
+	case kAKSOpen:
+	case kAKSUnloadBag:
+	case kAKSSetSystem:
+	case kAKSUnlockDevice:
+	case kAKSUnlockBag:
+	case kAKSLockBag:
+	case kAKSAssertHold:
+	case kAKSAssertDrop:
+	case kAKSUnloadSessionBags:
+	case kAKSNotifyStateSet:
+		args->scalarOutputCount = 0;
+		break;
+	case kAKSGetSystem:
+		if (out_scalars < 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		args->scalarOutput[0] = SWEET_AKS_SYSTEM_HANDLE;
+		args->scalarOutputCount = 1;
+		break;
+	case kAKSGetLockState:
+		if (out_scalars < 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		args->scalarOutput[0] = SWEET_AKS_LOCK_STATE;
+		args->scalarOutputCount = 1;
+		break;
+	case kAKSGetDeviceState:
+		args->scalarOutputCount = 0;
+		ret = sweet_aks_device_state(args);
+		break;
+	default:
+		ret = kIOReturnUnsupported;
+		break;
+	}
+
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("MUNCH AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name, selector,
+	    arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	return ret;
+}
+#endif /* SWEET */
diff --git a/iokit/Kernel/arm/SweetWatchdog.cpp b/iokit/Kernel/arm/SweetWatchdog.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetWatchdog.cpp
@@ -0,0 +1,107 @@
+/*
+ * Built-in IOWatchdog for SWEET.
+ *
+ * watchdogd (launchd job with _PanicOnCrash) opens IOServiceMatching(
+ * "IOWatchdog") with type 1 and exits when it is missing, which panics the
+ * system. On Apple hardware the kext arms a SoC watchdog that resets the
+ * device unless watchdogd keeps checking in. SWEET has no reset path, so
+ * this service accepts every call (check-in 1, enable/disable userspace
+ * monitoring 3/4, 0/5, struct calls 2 and 9) and does nothing; each
+ * selector is logged the first time it is used.
+ *
+ * watchdogd also writes the device boot stage to the PMU: it looks up
+ * the IOService with IOPMUPrimary = 1 and crashes when there is none
+ * (customer builds ignore -wdt_no_pmu). SWEET has no Apple PMU, so this
+ * service carries IOPMUPrimary and accepts property writes.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <sys/proc.h>
+
+class IOWatchdog : public IOService {
+	OSDeclareDefaultStructors(IOWatchdog);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOWatchdog, IOService);
+
+IOReturn
+IOWatchdog::setProperties(__unused OSObject *properties)
+{
+	return kIOReturnSuccess;
+}
+
+bool
+IOWatchdog::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "IOWatchdogUserClient");
+	setProperty("IOPMUPrimary", 1ULL, 32);
+	registerService();
+	IOLog("MUNCH WDT: IOWatchdog registered (accepts check-ins, never fires)\n");
+	return true;
+}
+
+class IOWatchdogUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IOWatchdogUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOWatchdogUserClient, IOUserClient);
+
+IOReturn
+IOWatchdogUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+static uint64_t sweet_wdt_logged;       /* selectors already logged (< 64) */
+
+IOReturn
+IOWatchdogUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	if (args->structureOutputDescriptor != NULL) {
+		IOByteCount len = args->structureOutputDescriptor->getLength();
+		for (IOByteCount off = 0; off < len; off += 8) {
+			static const uint64_t zero = 0;
+			args->structureOutputDescriptor->writeBytes(off, &zero, len - off < 8 ? len - off : 8);
+		}
+	} else if (args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+
+	if (selector >= 64 || !(sweet_wdt_logged & (1ULL << selector))) {
+		if (selector < 64) {
+			sweet_wdt_logged |= 1ULL << selector;
+		}
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("MUNCH WDT: %s sel %u in %u/%u out %u/%u -> ok\n", name, selector,
+		    args->scalarInputCount, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+#endif /* SWEET */
