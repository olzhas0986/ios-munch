+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * MUNCH: daemons started by launchd write stdout/stderr to /dev/null, and
+ * pointing a launchd job at /dev/console stops it from launching at all
+ * (backboardd, v8 image). Instead, what the processes named in boot-arg
+ * munchnull (comma separated, default "backboardd,SpringBoard") write to
+ * /dev/null goes to the console as
+ * "|name| text". munchnull=- turns it off.
+ */
+static char munch_null_names[128];
+static int munch_null_parsed;
+
+static bool
+munch_null_tee(char *name, size_t len)
+{
+	if (!munch_null_parsed) {
+		if (!PE_parse_boot_argn("munchnull", munch_null_names, sizeof(munch_null_names))) {
+			strlcpy(munch_null_names, "backboardd,SpringBoard", sizeof(munch_null_names));
+		}
+		munch_null_parsed = 1;
+	}
+	proc_selfname(name, (int)len);
+	size_t n = strlen(name);
+	for (const char *t = munch_null_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+#endif
