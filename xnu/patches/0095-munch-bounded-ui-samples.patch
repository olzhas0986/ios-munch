+/* Bounded best-effort user stacks; no task suspension or storage writes. */
+void munch_sample_task(const char *name, int pid, task_t task);
+void
+munch_sample_task(const char *name, int pid, task_t task)
+{
+	thread_t selected[4], thread;
+	unsigned count = 0;
+	uint64_t slide = 0;
+	vm_map_t map = get_task_map(task);
+	vm_shared_region_t sr = vm_shared_region_get(task);
+	if (sr != NULL) {
+		slide = sr->sr_slide;
+		vm_shared_region_deallocate(sr);
+	}
+	printf("MUNCH SMP %s[%d] slide 0x%llx mh 0x%llx\n", name, pid, slide, task->mach_header_vm_address);
+	vm_map_reference(map);
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		thread_reference(thread);
+		selected[count++] = thread;
+		if (count == 4) { break; }
+	}
+	task_unlock(task);
+	/* User memory reads may fault: never hold the task lock across them. */
+	for (unsigned t = 0; t < count; t++) {
+		arm_saved_state_t *ss = find_user_regs(selected[t]);
+		if (ss != NULL && is_saved_state64(ss)) {
+			char line[300];
+			uint64_t fp = get_saved_state_fp(ss);
+			int n = snprintf(line, sizeof(line), "MUNCH SMP %s t%u pc 0x%llx lr 0x%llx sp 0x%llx bt", name, t,
+			    get_saved_state_pc(ss), get_saved_state_lr(ss), get_saved_state_sp(ss));
+			for (int i = 0; i < 8 && fp != 0 && (fp & 7) == 0 && n < (int)sizeof(line) - 20; i++) {
+				uint64_t frame[2];
+				if (vm_map_read_user(map, fp, frame, sizeof(frame)) != KERN_SUCCESS) { break; }
+				n += snprintf(line + n, sizeof(line) - n, " 0x%llx", frame[1]);
+				if (frame[0] <= fp) { break; }
+				fp = frame[0];
+			}
+			printf("%s\n", line);
+		} else {
+			printf("MUNCH SMP %s t%u no user state\n", name, t);
+		}
+		thread_deallocate(selected[t]);
+	}
+	vm_map_deallocate(map);
+}
