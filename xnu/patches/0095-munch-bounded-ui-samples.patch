--- /dev/null
+++ b/bsd/dev/munch_sample.c
@@ -0,0 +1,76 @@
+/* Two diagnostic snapshots only, at approximately 60 and 120 seconds. */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/proc_internal.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+
+extern task_t proc_task(proc_t);
+extern int hz;
+/* This Mach-private termination entry is not in BSD exported headers. */
+extern void thread_terminate_self(void);
+void munch_sample_start(void);
+extern void munch_sample_task(const char *, int, task_t);
+static char munch_sample_names[128];
+
+static bool
+munch_sample_wanted(const char *name)
+{
+	size_t n = strlen(name);
+	for (const char *t = munch_sample_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t len = end ? (size_t)(end - t) : strlen(t);
+		if (len == n && n > 0 && strncmp(t, name, n) == 0) { return true; }
+		if (!end) { break; }
+		t = end + 1;
+	}
+	return false;
+}
+
+static int
+munch_sample_proc(proc_t p, void *arg)
+{
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (munch_sample_wanted(name)) {
+		task_t task = proc_task(p);
+		if (task != TASK_NULL) {
+			task_reference(task);
+			++*(unsigned *)arg;
+			munch_sample_task(name, proc_pid(p), task);
+			task_deallocate(task);
+		}
+	}
+	return PROC_RETURNED;
+}
+
+static void
+munch_sample_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	if (!PE_parse_boot_argn("munchsample", munch_sample_names, sizeof(munch_sample_names))) {
+		strlcpy(munch_sample_names, "SpringBoard,backboardd", sizeof(munch_sample_names));
+	}
+	munch_sample_names[sizeof(munch_sample_names) - 1] = 0;
+	if (munch_sample_names[0] != '-') {
+		for (int i = 1; i <= 2; i++) {
+			unsigned matched = 0;
+			(void)tsleep(&chan, PZERO, "munchsmp", 60 * hz);
+			printf("MUNCH SMP --- sample %d\n", i);
+			proc_iterate(PROC_ALLPROCLIST, munch_sample_proc, &matched, NULL, NULL);
+			printf("MUNCH SMP --- matched %u; sample %d done\n", matched, i);
+		}
+	}
+	thread_terminate_self();
+}
+
+void
+munch_sample_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(munch_sample_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
