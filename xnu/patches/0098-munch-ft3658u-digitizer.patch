+/* Munch-only active RPMh votes for FT3658U supplies, using firmware CMD DB. */
+#include <IOKit/IOLib.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include "MunchPowerFormat.h"
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+bool munchEnableTouchPower(void);
+static uint32_t powerRead(vm_offset_t base, unsigned offset)
+{
+    uint32_t value = *(volatile uint32_t *)(base + offset);
+    __asm__ volatile("dmb oshld" ::: "memory"); return value;
+}
+static void powerWrite(vm_offset_t base, unsigned offset, uint32_t value)
+{
+    __asm__ volatile("dmb oshst" ::: "memory");
+    *(volatile uint32_t *)(base + offset) = value;
+    __asm__ volatile("dsb osh" ::: "memory");
+}
+static bool powerSet(vm_offset_t base, unsigned offset, uint32_t value)
+{
+    powerWrite(base, offset, value);
+    for (unsigned i = 0; i < 2000; ++i) { if (powerRead(base, offset) == value) return true; IODelay(1); }
+    return false;
+}
+static bool emptySlot(vm_offset_t tcs, unsigned id)
+{
+    unsigned offset = id * 0x2a0;
+    uint32_t status = powerRead(tcs, offset + 0x18);
+    return status != 0xffffffff && (status & 1) &&
+        powerRead(tcs, offset + 0x1c) == 0 && powerRead(tcs, offset + 0x10) == 0 &&
+        !(powerRead(tcs, offset + 0x14) & 0x1010000) &&
+        !(powerRead(tcs, 4) & (1u << id));
+}
+static bool railVote(vm_offset_t tcs, unsigned address, unsigned millivolts)
+{
+    unsigned id = 5;
+    /* Live DT assigns SLEEP slots0..1, ACTIVE2..4, WAKE5..7. */
+    for (unsigned slot = 2; slot <= 4; ++slot) if (emptySlot(tcs, slot)) { id = slot; break; }
+    if (id == 5) { IOLog("MUNCH POWER: no idle ACTIVE slot\n"); return false; }
+    unsigned bit = 1u << id, offset = id * 0x2a0;
+    uint32_t irqEnable = powerRead(tcs, 0);
+    if (irqEnable == 0xffffffff || !powerSet(tcs, 0, irqEnable & ~bit)) return false;
+    if (!emptySlot(tcs, id)) {
+        (void)powerSet(tcs, 0, (powerRead(tcs, 0) & ~bit) | (irqEnable & bit)); return false;
+    }
+    /* After the first payload write, failure quarantines this slot: no retry. */
+    const unsigned reg[] = {0, 8, 4}, value[] = {millivolts, 7, 1};
+    for (unsigned cmd = 0; cmd < 3; ++cmd) {
+        unsigned c = offset + cmd * 0x14;
+        if (!powerSet(tcs, c + 0x30, 0x10108) || !powerSet(tcs, c + 0x34, address + reg[cmd]) ||
+            !powerSet(tcs, c + 0x38, value[cmd])) return false;
+    }
+    if (!powerSet(tcs, offset + 0x10, 7) || !powerSet(tcs, offset + 0x1c, 7) ||
+        !powerSet(tcs, offset + 0x14, 0) || !powerSet(tcs, offset + 0x14, 0x10000)) return false;
+    powerWrite(tcs, offset + 0x14, 0x1010000);
+    bool complete = false;
+    for (unsigned us = 0; us < 20000; ++us) {
+        uint32_t irq = powerRead(tcs, 4), idle = powerRead(tcs, offset + 0x18);
+        complete = irq != 0xffffffff && idle != 0xffffffff && (irq & bit) && (idle & 1);
+        for (unsigned c = 0; c < 3; ++c) {
+            uint32_t status = powerRead(tcs, offset + c * 0x14 + 0x3c);
+            complete &= status != 0xffffffff && (status & 0x10100) == 0x10100;
+        }
+        if (complete) break;
+        IODelay(1);
+    }
+    if (!complete) { IOLog("MUNCH POWER: TCS%u timeout, quarantined\n", id); return false; }
+    if (!powerSet(tcs, offset + 0x14, 0x10000) || !powerSet(tcs, offset + 0x14, 0) ||
+        !powerSet(tcs, offset + 0x1c, 0) || !powerSet(tcs, offset + 0x10, 0)) return false;
+    powerWrite(tcs, 8, bit);
+    if ((powerRead(tcs, 4) & bit) || !powerSet(tcs, 0, (powerRead(tcs, 0) & ~bit) | (irqEnable & bit))) return false;
+    IOLog("MUNCH POWER: %#x %umV active vote complete\n", address, millivolts);
+    return true;
+}
+bool munchEnableTouchPower(void)
+{
+    int enabled = 1;
+    PE_parse_boot_argn("munchtouch_power", &enabled, sizeof(enabled));
+    if (!enabled) return true;
+    vm_offset_t database = ml_io_map(0x80860000, 0x20000);
+    if (!database) return false;
+    /* Immutable reserved CMD DB; copy its bounded image before parsing. */
+    uint8_t *copy = (uint8_t *)IOMalloc(0x20000);
+    if (!copy) return false;
+    for (unsigned i = 0; i < 0x20000; ++i) copy[i] = *(volatile uint8_t *)(database + i);
+    uint32_t l1 = munchFindRail(copy, 0x20000, "ldoc1"), l10 = munchFindRail(copy, 0x20000, "ldoc10");
+    IOFree(copy, 0x20000);
+    if (!l1 || !l10 || l1 == l10) { IOLog("MUNCH POWER: invalid L1C/L10C CMD DB entries\n"); return false; }
+    vm_offset_t rsc = ml_io_map(0x18220000, 0x10000);
+    if (!rsc) return false;
+    unsigned revision = powerRead(rsc, 0), config = powerRead(rsc, 12);
+    unsigned major = (revision >> 16) & 255, count = (config >> 12) & 63, commands = config >> 27;
+    IOLog("MUNCH POWER: RSC rev=%#x config=%#x L1C=%#x L10C=%#x\n", revision, config, l1, l10);
+    if ((major != 1 && major != 2) || config == 0xffffffff || count < 8 || count > 16 || commands < 3 || commands > 16) return false;
+    if (!railVote(rsc + 0xd00, l1, 1800)) return false;
+    IOSleep(1);
