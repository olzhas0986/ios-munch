+/* Munch FT3658U: SPI FIFO transport and coherent HID digitizer frames. */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <pexpert/pexpert.h>
+#include <mach/mach_types.h>
+#include "IOHIDEventService.h"
+#include "IOHIDEvent.h"
+#include "IOHIDUsageTables.h"
+#include "FT3658Format.h"
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern "C" uint64_t mach_absolute_time(void);
+bool munchEnableTouchPower(void);
+
+struct MunchSPI {
+    vm_offset_t engine, gcc, north, south;
+    unsigned fifo;
+    bool unusable;
+};
+static uint32_t loadReg(vm_offset_t base, unsigned reg)
+{
+    uint32_t result = *(volatile uint32_t *)(base + reg);
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return result;
+}
+static void storeReg(vm_offset_t base, unsigned reg, uint32_t value)
+{
+    __asm__ volatile("dmb oshst" ::: "memory");
+    *(volatile uint32_t *)(base + reg) = value;
+    __asm__ volatile("dsb osh" ::: "memory");
+}
+static bool clearWithin(vm_offset_t base, unsigned reg, uint32_t mask)
+{
+    for (unsigned tries = 0; tries < 2000; ++tries) {
+        if (!(loadReg(base, reg) & mask)) return true;
+        IODelay(1);
+    }
+    return false;
+}
+static void configurePin(vm_offset_t tile, unsigned gpio, unsigned mux, unsigned pull, unsigned drive, bool output, bool high = true)
+{
+    unsigned cfg = gpio * 4096;
+    if (output) storeReg(tile, cfg + 4, (loadReg(tile, cfg + 4) & ~2u) | (high ? 2u : 0u));
+    uint32_t old = loadReg(tile, cfg);
+    storeReg(tile, cfg, (old & ~0x3ffu) | (mux << 2) | pull | (drive << 6) | (output ? 0x200 : 0));
+}
+static void abortSPI(MunchSPI &bus)
+{
+    storeReg(bus.engine, 0x604, 2);
+    bool acknowledged = false;
+    for (unsigned i = 0; i < 2000; ++i) {
+        if (loadReg(bus.engine, 0x610) & (1u << 5)) { acknowledged = true; break; }
+        IODelay(1);
+    }
+    bus.unusable = !acknowledged || !clearWithin(bus.engine, 0x40, 1);
+    for (unsigned i = 0; i < 64; ++i) {
+        if (!(loadReg(bus.engine, 0x804) & 0x1ffffff)) break;
+        (void)loadReg(bus.engine, 0x780);
+    }
+    storeReg(bus.engine, 0x618, 0xffffffff);
+}
+static bool exchangeSPI(MunchSPI &bus, uint8_t command, unsigned bytes, uint8_t response[128])
+{
+    uint8_t request[128] = {};
+    if (bus.unusable || !bytes || bytes > 119 || (loadReg(bus.engine, 0x40) & 1)) return false;
+    unsigned length = bytes + 9, tx = 0, rx = 0;
+    request[0] = command; request[1] = 0xa0; request[2] = bytes >> 8; request[3] = bytes;
+    storeReg(bus.engine, 0x618, 0xffffffff);
+    storeReg(bus.engine, 0x26c, length);
+    storeReg(bus.engine, 0x270, length);
+    storeReg(bus.engine, 0x600, 3u << 27);
+    for (unsigned attempt = 0; attempt < 5000; ++attempt) {
+        uint32_t irq = loadReg(bus.engine, 0x610);
+        if (irq & (0xeu | (1u << 9) | (1u << 10) | (1u << 12) | (1u << 13))) break;
+        unsigned available = loadReg(bus.engine, 0x804) & 0x1ffffff;
+        if (available > 64 || available > length - rx) break;
+        while (available--) response[rx++] = (uint8_t)loadReg(bus.engine, 0x780);
+        unsigned occupied = loadReg(bus.engine, 0x800) & 0xfffffff;
+        if (occupied > bus.fifo) break;
+        unsigned space = bus.fifo - occupied;
+        while (space && tx < length) { storeReg(bus.engine, 0x700, request[tx++]); space--; }
+        if ((irq & 1) && tx == length && rx == length) {
+            storeReg(bus.engine, 0x618, irq);
+            IODelay(150);
+            return true;
+        }
+        IODelay(1);
+    }
+    abortSPI(bus);
+    IODelay(150);
+    return false;
+}
+static bool readSPI(MunchSPI &bus, uint8_t reg, unsigned bytes, uint8_t response[128])
+{
+    for (unsigned retry = 0; retry < 3 && !bus.unusable; ++retry) {
+        if (exchangeSPI(bus, reg, bytes, response) && !(response[3] & 0xa0)) {
+            uint16_t received = response[bytes + 7] | ((unsigned)response[bytes + 8] << 8);
+            if (ft3658Checksum(response + 7, bytes) == received) return true;
+        }
+        IODelay(150);
+    }
+    return false;
+}
+static bool startSPI(MunchSPI &bus)
+{
+    bus.gcc = ml_io_map(0x100000, 0x53000);
+    if (!bus.gcc) return false;
+    /* Only QUP0 AHB/core and SE4 branch votes; no shared PLL changes. */
+    storeReg(bus.gcc, 0x52008, loadReg(bus.gcc, 0x52008) | 0x43c0);
+    uint32_t config = loadReg(bus.gcc, 0x174d4), dfs = loadReg(bus.gcc, 0x174e4);
+    IOLog("MUNCH TOUCH: clocks vote=%#x cfg=%#x dfs=%#x\n", loadReg(bus.gcc, 0x52008), config, dfs);
+    if (dfs & 1) {
+        if ((loadReg(bus.gcc, 0x174ec) & 0x371f) != 1) {
+            IOLog("MUNCH TOUCH: unsupported DFS parent; stopped\n"); return false;
+        }
+    } else {
+        storeReg(bus.gcc, 0x174d4, (config & ~0x10371fu) | 1);
+        storeReg(bus.gcc, 0x174d0, loadReg(bus.gcc, 0x174d0) | 1);
+        if (!clearWithin(bus.gcc, 0x174d0, 1)) return false;
+    }
+    const unsigned branch[] = {0x17004, 0x17008, 0x23000, 0x23008, 0x174cc};
+    for (unsigned i = 0; i < 5; ++i) if (!clearWithin(bus.gcc, branch[i], 1u << 31)) {
+        IOLog("MUNCH TOUCH: halted branch %#x\n", branch[i]); return false;
+    }
+    bus.engine = ml_io_map(0x990000, 0x4000);
+    bus.north = ml_io_map(0xf900000, 0xc000);
+    bus.south = ml_io_map(0xf500000, 0x28000);
+    if (!bus.engine || !bus.north || !bus.south) return false;
+    uint32_t fw = loadReg(bus.engine, 0x68), status = loadReg(bus.engine, 0x40);
+    IOLog("MUNCH TOUCH: SE4 fw=%#x status=%#x reset=%#x irq=%#x\n", fw, status,
+        loadReg(bus.south, 33 * 4096 + 4), loadReg(bus.south, 39 * 4096 + 4));
+    if (((fw >> 8) & 255) != 1 || (status & 0x1001)) {
+        IOLog("MUNCH TOUCH: missing SPI sequencer or busy engine; stopped\n"); return false;
+    }
+    unsigned hw = loadReg(bus.engine, 0xe24);
+    bus.fifo = (hw >> 16) & 63;
+    if (((hw >> 24) & 63) != 32 || bus.fifo < 2 || (loadReg(bus.engine, 0x64) & 1)) {
+        IOLog("MUNCH TOUCH: unsupported FIFO %#x\n", hw); return false;
+    }
+    for (unsigned pin = 8; pin <= 11; ++pin) configurePin(bus.north, pin, 1, 0, 2, false);
+    configurePin(bus.south, 33, 0, 3, 3, true, false);
+    IOSleep(1);
+    if (!munchEnableTouchPower()) { IOLog("MUNCH TOUCH: supply initialization failed\n"); return false; }
+    storeReg(bus.south, 33 * 4096 + 4, loadReg(bus.south, 33 * 4096 + 4) | 2);
+    IOSleep(200);
+    configurePin(bus.south, 39, 0, 3, 3, false);
+    storeReg(bus.engine, 0x28, loadReg(bus.engine, 0x28) | 0x7f);
+    storeReg(bus.engine, 0xe30, loadReg(bus.engine, 0xe30) | 0xf);
+    storeReg(bus.engine, 0x24, 0x7f); storeReg(bus.engine, 0x20, 1);
+    storeReg(bus.engine, 0x7c, 0); storeReg(bus.engine, 0x48, 0x41);
+    const unsigned zero[] = {0x224,0x22c,0x230,0x24c,0x250,0x25c,0x278,0x264,0x288,0x254,0x258,0xe18,0x614,0xe1c};
+    for (unsigned i = 0; i < sizeof(zero) / sizeof(zero[0]); ++i) storeReg(bus.engine, zero[i], 0);
+    storeReg(bus.engine, 0x268, 4); /*8-bit SPI word*/
+    storeReg(bus.engine, 0x260, 0xff); storeReg(bus.engine, 0x284, 0xff); /*one byte/FIFO word*/
+    uint8_t response[128] = {}, high = 0;
+    if (readSPI(bus, 0xa3, 1, response)) high = response[7];
+    if (!readSPI(bus, 0x9f, 1, response) || high != 0x56 || response[7] != 0x52) {
+        IOLog("MUNCH TOUCH: no FT3658U ID (hi=%#x); check L10C/L1C and controller firmware\n", high); return false;
+    }
+    IOLog("MUNCH TOUCH: FT3658U 56:52, SPI 4.8MHz ready\n");
+    return true;
+}
+
+class MunchDigitizer : public IOHIDEventService {
+    OSDeclareDefaultStructors(MunchDigitizer);
+public:
+    bool start(IOService *) APPLE_KEXT_OVERRIDE;
+    void stop(IOService *) APPLE_KEXT_OVERRIDE;
+    void free(void) APPLE_KEXT_OVERRIDE;
+    IOWorkLoop *getWorkLoop(void) const APPLE_KEXT_OVERRIDE;
+protected:
+    UInt32 getPrimaryUsagePage() APPLE_KEXT_OVERRIDE { return kHIDPage_Digitizer; }
+    UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return kHIDUsage_Dig_TouchScreen; }
+    UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 0x3658; }
+private:
+    static void tick(OSObject *, IOTimerEventSource *);
+    void consume(const FT3658Frame &);
+    IOWorkLoop *work;
+    IOTimerEventSource *timer;
+    MunchSPI bus;
+    FT3658Point previous[10];
+    bool edge[10];
+    unsigned active, errors, notes;
+    bool initialized;
+};
+OSDefineMetaClassAndStructors(MunchDigitizer, IOHIDEventService);
+IOWorkLoop *MunchDigitizer::getWorkLoop(void) const { return work; }
+bool MunchDigitizer::start(IOService *provider)
+{
+    int enabled = 1;
+    PE_parse_boot_argn("munchtouch", &enabled, sizeof(enabled));
+    if (!enabled) return false;
+    work = IOWorkLoop::workLoop();
+    if (!work || !IOHIDEventService::start(provider)) return false;
+    setProperty("DisplayIntegrated", kOSBooleanTrue);
+    setProperty("SurfaceWidth", (unsigned long long)(68 << 16), 32);
+    setProperty("SurfaceHeight", (unsigned long long)(151 << 16), 32);
+    timer = IOTimerEventSource::timerEventSource(this, &MunchDigitizer::tick);
+    if (!timer || work->addEventSource(timer) != kIOReturnSuccess) return false;
+    registerService();
+    IOLog("MUNCH TOUCH: HID digitizer registered\n");
+    timer->setTimeoutMS(1500);
+    return true;
+}
+void MunchDigitizer::consume(const FT3658Frame &frame)
+{
+    FT3658Point next[10] = {};
+    for (unsigned i = 0; i < frame.count; ++i) next[frame.point[i].id] = frame.point[i];
+    unsigned changed = active ^ frame.downMask;
+    for (unsigned i = 0; i < 10; ++i) {
+        if ((frame.downMask & (1u << i)) && (previous[i].x != next[i].x || previous[i].y != next[i].y)) changed |= 1u << i;
+        if (!(active & (1u << i)) && (frame.downMask & (1u << i)))
+            edge[i] = next[i].x < 48 || next[i].x >= 1032 || next[i].y < 48 || next[i].y >= 2352;
+    }
+    if (!changed) return;
+    uint64_t now = mach_absolute_time();
+    IOHIDEvent *group = IOHIDEvent::digitizerEvent(now, 0, kIOHIDDigitizerTransducerTypeHand, false, 0, 0, 0);
+    if (!group) return;
+    group->setIntegerValue(kIOHIDEventFieldDigitizerCollection, 1);
+    unsigned combined = 0;
+    bool complete = true;
+    for (unsigned i = 0; i < 10; ++i) {
+        unsigned bit = 1u << i;
+        if (!((active | frame.downMask) & bit)) continue;
+        bool down = (frame.downMask & bit) != 0;
+        FT3658Point point = down ? next[i] : previous[i];
+        IOFixed x = (IOFixed)(((uint64_t)point.x << 16) / 1080), y = (IOFixed)(((uint64_t)point.y << 16) / 2400);
+        IOHIDEvent *child = IOHIDEvent::digitizerEvent(now, i + 2, kIOHIDDigitizerTransducerTypeFinger, down, down ? 1 : 0, x, y);
+        if (!child) { complete = false; break; }
+        unsigned flags = edge[i] ? kIOHIDDigitizerEventFromEdgeTip : 0;
+        if ((active ^ frame.downMask) & bit) flags |= kIOHIDDigitizerEventTouch | kIOHIDDigitizerEventRange;
+        if (!(active & bit) && down) flags |= kIOHIDDigitizerEventIdentity;
+        if ((changed & bit) && down) flags |= kIOHIDDigitizerEventPosition;
+        child->setIntegerValue(kIOHIDEventFieldDigitizerIndex, i);
+        child->setIntegerValue(kIOHIDEventFieldDigitizerIdentity, i + 2);
+        child->setIntegerValue(kIOHIDEventFieldDigitizerTouch, down);
+        child->setIntegerValue(kIOHIDEventFieldDigitizerEventMask, flags);
+        group->appendChild(child); child->release(); combined |= flags;
+        group->setFixedValue(kIOHIDEventFieldDigitizerX, x); group->setFixedValue(kIOHIDEventFieldDigitizerY, y);
+    }
+    if (complete) {
+        group->setIntegerValue(kIOHIDEventFieldDigitizerRange, frame.downMask != 0);
+        group->setIntegerValue(kIOHIDEventFieldDigitizerTouch, frame.downMask != 0);
+        group->setIntegerValue(kIOHIDEventFieldDigitizerButtonMask, frame.downMask != 0);
+        group->setIntegerValue(kIOHIDEventFieldDigitizerEventMask, combined);
+        if ((active ^ frame.downMask) && notes++ < 24) IOLog("MUNCH TOUCH: contacts %#x -> %#x\n", active, frame.downMask);
+        memcpy(previous, next, sizeof(previous)); active = frame.downMask;
+        dispatchEvent(group);
+    }
+    group->release();
+}
+void MunchDigitizer::tick(OSObject *owner, IOTimerEventSource *source)
+{
+    MunchDigitizer *self = OSDynamicCast(MunchDigitizer, owner);
+    if (!self) return;
+    if (!self->initialized) {
+        self->initialized = true;
+        if (!startSPI(self->bus)) return;
+    }
+    uint8_t bytes[128] = {};
+    FT3658Frame frame = {};
+    if (readSPI(self->bus, 1, 90, bytes) && ft3658Unpack(bytes, 99, frame)) {
+        self->errors = 0; self->consume(frame);
+    } else if (self->bus.unusable || ++self->errors >= 5) {
+        FT3658Frame release = {}; self->consume(release);
+        IOLog("MUNCH TOUCH: invalid reports or FIFO failure; input stopped\n");
+        return;
+    }
+    source->setTimeoutMS(10);
+}
+void MunchDigitizer::stop(IOService *provider)
+{
+    if (timer) { timer->cancelTimeout(); if (work) work->removeEventSource(timer); }
+    FT3658Frame release = {}; consume(release);
+    IOHIDEventService::stop(provider);
+}
+void MunchDigitizer::free(void)
+{
+    OSSafeReleaseNULL(timer);
+    OSSafeReleaseNULL(work);
+    IOHIDEventService::free();
+}
