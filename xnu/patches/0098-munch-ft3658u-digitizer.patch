+/* FT3658U normal read response: two header bytes, ten slots, gesture tail. */
+#ifndef MUNCH_FT3658_FORMAT_H
+#define MUNCH_FT3658_FORMAT_H
+#include <stdint.h>
+#include <stddef.h>
+struct FT3658Point { uint16_t x, y; uint8_t id, down; };
+struct FT3658Frame { FT3658Point point[10]; unsigned count, downMask; };
+static inline uint16_t ft3658Checksum(const uint8_t *data, size_t count)
+{
+    uint16_t value = 0xffff;
+    for (size_t i = 0; i < count; ++i) {
+        value ^= data[i];
+        for (unsigned bit = 0; bit != 8; ++bit)
+            value = (uint16_t)((value >> 1) ^ ((value & 1) ? 0x8408 : 0));
+    }
+    return value;
+}
+static inline bool ft3658Unpack(const uint8_t *response, size_t length, FT3658Frame &frame)
+{
+    if (!response || length != 99 || (response[3] & 0xa0)) return false;
+    const uint8_t *data = response + 7;
+    if (ft3658Checksum(data, 90) != (uint16_t)(response[97] | ((unsigned)response[98] << 8))) return false;
+    unsigned expected = data[1] & 15;
+    if (expected > 10) return false;
+    FT3658Frame next = {};
+    unsigned used = 0, down = 0;
+    for (unsigned slot = 0; slot < 10; ++slot) {
+        const uint8_t *p = data + 2 + slot * 6;
+        unsigned id = p[2] >> 4, kind = p[0] >> 6;
+        if (id == 15) break;
+        if (id >= 10 || (used & (1u << id)) || kind == 3) return false;
+        unsigned x = ((p[0] & 15) << 12) | (p[1] << 4) | (p[4] >> 4);
+        unsigned y = ((p[2] & 15) << 12) | (p[3] << 4) | (p[4] & 15);
+        bool touching = kind != 1;
+        if (touching && (x > 1080 * 16 || y > 2400 * 16)) return false;
+        x /= 16; y /= 16;
+        next.point[next.count++] = {(uint16_t)(x < 1080 ? x : 1079), (uint16_t)(y < 2400 ? y : 2399), (uint8_t)id, (uint8_t)touching};
+        used |= 1u << id;
+        if (touching) { next.downMask |= 1u << id; down++; }
+    }
+    if (down != expected) return false;
+    frame = next;
+    return true;
+}
+#endif
