+/* Linux CMD DB v1:144-byte header,8 slave headers,24-byte resource entries. */
+#ifndef MUNCH_POWER_FORMAT_H
+#define MUNCH_POWER_FORMAT_H
+#include <stdint.h>
+#include <stddef.h>
+static inline unsigned munchLE16(const uint8_t *p) { return p[0] | ((unsigned)p[1] << 8); }
+static inline uint32_t munchLE32(const uint8_t *p) { return munchLE16(p) | ((uint32_t)munchLE16(p + 2) << 16); }
+static inline uint32_t munchFindRail(const uint8_t *data, size_t size, const char *name)
+{
+    if (!data || !name || size < 144 || munchLE32(data) != 1 || munchLE32(data + 4) != 0x0c0330db) return 0;
+    uint8_t key[8] = {};
+    unsigned length = 0;
+    while (length < 8 && name[length]) { key[length] = name[length]; ++length; }
+    if (!length || length == 8) return 0;
+    uint32_t found = 0;
+    for (unsigned slave = 0; slave < 8; ++slave) {
+        const uint8_t *h = data + 8 + 16 * slave;
+        unsigned kind = munchLE16(h), offset = 144 + munchLE16(h + 2), count = munchLE16(h + 6);
+        if (!kind) break;
+        if (offset > size || count > (size - offset) / 24) return 0;
+        for (unsigned e = 0; e < count; ++e) {
+            const uint8_t *p = data + offset + e * 24;
+            bool same = true;
+            for (unsigned c = 0; c < 8; ++c) same &= p[c] == key[c];
+            if (!same) continue;
+            unsigned address = munchLE32(p + 16), aux = 144 + munchLE16(h + 4) + munchLE16(p + 22), length = munchLE16(p + 20);
+            if (kind != 4 || (address >> 16) != 4 || (address & 15) || aux > size || length > size - aux || found) return 0;
+            found = address;
+        }
+    }
+    return found;
+}
