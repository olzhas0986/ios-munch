+/* SM8250 early SMP groundwork. This does NOT enable secondary startup. */
+/* PSCI CPU_ON (SMCCC 64-bit); secondary entry is not yet wired. */
+static int32_t __attribute__((unused))
+munch_psci_cpu_on(uint64_t mpidr, uint64_t entry_pa, uint64_t context)
+{
+    register uint64_t x0 __asm__("x0") = 0xc4000003ULL;
+    register uint64_t x1 __asm__("x1") = mpidr;
+    register uint64_t x2 __asm__("x2") = entry_pa;
+    register uint64_t x3 __asm__("x3") = context;
+    __asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+        "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+        "x14", "x15", "x16", "x17", "cc", "memory");
+    return (int32_t)x0;
+}
 
