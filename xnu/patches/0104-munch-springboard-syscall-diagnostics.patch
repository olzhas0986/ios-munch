--- a/bsd/dev/arm/systemcalls.c
+++ b/bsd/dev/arm/systemcalls.c
@@ -147,10 +147,15 @@
 	if (do_count_syscalls > 0) {
 		syscalls_log[code]++;
 	}
 #endif
 	pid = proc_pid(proc);
+	/* Munch: diagnose invalid BSD syscalls from SpringBoard. */
+	if (syscode == SYS_invalid && strcmp(proc->p_comm, "SpringBoard") == 0) {
+		printf("MUNCH SYSCALL: SpringBoard pid=%d invalid BSD syscall=%u\n",
+		    pid, (unsigned int)code);
+	}
 
 #ifdef CONFIG_IOCOUNT_TRACE
 	uthread->uu_iocount = 0;
 	uthread->uu_vpindex = 0;
 #endif
@@ -202,10 +207,14 @@
 	kern_allocation_name_t
 	prior __assert_only = thread_set_allocation_name(NULL);
 	assertf(prior == NULL, "thread_set_allocation_name(\"%s\") not cleared", kern_allocation_get_name(prior));
 #endif /* DEBUG || DEVELOPMENT */
 
+	if (error == ENOSYS && strcmp(proc->p_comm, "SpringBoard") == 0) {
+		printf("MUNCH SYSCALL: SpringBoard pid=%d BSD syscall=%u returned ENOSYS\n",
+		    pid, (unsigned int)code);
+	}
 	arm_prepare_syscall_return(callp, state, uthread, error);
 
 	uthread->uu_flag &= ~UT_NOTCANCELPT;
 	uthread->syscall_code = 0;
 
